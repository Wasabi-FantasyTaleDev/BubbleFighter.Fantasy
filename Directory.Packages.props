<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Wasmtime" Version="48.0.2" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- The ORM without its bundled drivers: the persistence plugins reference only the two drivers they use
         (MySqlConnector, Microsoft.Data.Sqlite). The bundled package carried SQL Server, PostgreSQL, Oracle and
         three other drivers with their identity and crypto dependencies into every persistence plugin. -->
    <PackageVersion Include="SqlSugarCoreNoDrive" Version="5.1.4.221" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <!-- The binary serializer of the compiled client data. The runtime half is referenced by Contracts and loaded
         once by the host; a plugin that declares its own packed type also references the source generator. -->
    <PackageVersion Include="MemoryPack.Core" Version="1.21.4" />
    <PackageVersion Include="MemoryPack.Generator" Version="1.21.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
  </ItemGroup>
</Project>
