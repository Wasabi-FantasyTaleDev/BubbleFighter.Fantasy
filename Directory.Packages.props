<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Wasmtime" Version="48.0.2" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    <!-- SqlSugarCore pulls Oracle.ManagedDataAccess.Core, which pins
         System.Security.Cryptography.Pkcs 8.0.1. That 8.0.1 has two published
         advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) and NuGet audit
         reports them as NU1902/NU1903, which TreatWarningsAsErrors turns into a
         build failure. We never use the Oracle provider or CMS/PKCS#8 handling,
         so this raises the transitive floor only, staying on the 8.0 servicing
         line that .NET 8 shipped. 8.0.2 is the fixed release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
  </ItemGroup>
</Project>
