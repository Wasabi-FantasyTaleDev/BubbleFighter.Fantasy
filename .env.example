# Copy to .env and fill in real values. .env is git-ignored; never commit credentials.

# MySQL server hostname or IP used by the persistence.mysql plugin row.
# Docker Compose overrides this to the mysql service name inside the bff container.
BFF_MYSQL_HOST=127.0.0.1
# MySQL port.
BFF_MYSQL_PORT=3306
# MySQL user. Compose creates this account (must not be the server administrator name).
# Native installs that use a different account should override this.
BFF_MYSQL_USER=bff
# MySQL password. Profile interpolation requires a nonempty value even when a final
# patch disables MySQL. Use a disposable value for isolated-memory local checks.
BFF_MYSQL_PASSWORD=
# MySQL database name (any existing database; bf_game_db is only the default).
BFF_MYSQL_DATABASE=bf_game_db
# Database image of deploy/docker/compose.yaml. MariaDB idles in a fraction of MySQL 8.4's default memory.
# Without this line Compose keeps mysql:8.4, so a stack whose mysql-data volume MySQL created stays on it:
# MariaDB cannot open that volume.
BFF_DB_IMAGE=mariadb:11.4

# First-run setup token, at least 32 random characters. Required by deploy/docker/compose.yaml, whose
# setup page is reached from outside the container; a loopback-only setup does not need it.
BFF_SETUP_TOKEN=

# Console log level: Trace, Debug, Information, Warning, Error, Critical, None.
BFF_LOG_LEVEL=Information
# Optional Host ILogger file; disabled when unset. Full exceptions may contain user data.
# This example is inside deploy/docker/compose.yaml's persistent /app/state volume.
# Add the variable to the container environment; native services use their own data path.
# BFF_LOG_FILE=/app/state/logs/host.log
# Independent file threshold: Trace, Debug, Information, Warning, Error, Critical, None.
BFF_LOG_FILE_LEVEL=Warning
# UTF-8 bytes per file, 1024-1073741824 (default 16 MiB).
BFF_LOG_FILE_MAX_BYTES=16777216
# Retained slots including the active file, 1-32.
BFF_LOG_FILE_COUNT=5
# Pending record slots, 1-65536; newest records are dropped on overflow.
BFF_LOG_FILE_QUEUE_CAPACITY=256
# UTF-8 payload bytes including the in-flight record, 1024-268435456 (default 16 MiB).
BFF_LOG_FILE_MAX_QUEUED_BYTES=16777216
# Shutdown drain budget in milliseconds, 100-30000.
BFF_LOG_FILE_SHUTDOWN_TIMEOUT_MS=5000
# Reopen retry delays in milliseconds, 100-60000; maximum must be at least initial.
BFF_LOG_FILE_RETRY_INITIAL_MS=1000
BFF_LOG_FILE_RETRY_MAX_MS=60000
# Optional packet diagnostics; disabled during normal operation. Logs may contain user data.
# BFF_PACKET_LOG writes one line per packet to logs/<date>/packets-*.log.
BFF_PACKET_LOG=false
BFF_PACKET_CAPTURE=false

# Client data: <dir>/<build>/data holds the client archives the server reads at their original
# client paths (e.g. Packs/ServerShared_00000.pkn, Config/Config.bfz); <dir>/<build>/dataraw holds
# loose unpacked files by client path, read first. Supply the matching local client data.
# BFF_CLIENT_DATA=client-data
# Compiled client data: one <build>.bffdata per build, written on the first start and read by later
# starts instead of parsing the client workbooks. A cache; deleting it only makes the next start slower.
# BFF_COMPILED_DATA=state/compiled-data

# A server that serves several builds (profiles/all) can load each build with its first connection and unload it
# after this many minutes without a connection or a room. always (default) or on_demand; see the deployment guide.
# BFF_BUILD_ACTIVATION=always
# BFF_BUILD_IDLE_MINUTES=30

# Listener and advertised addresses; use distinct values behind NAT.
BFF_BIND_HOST=0.0.0.0
BFF_PUBLIC_HOST=127.0.0.1
# The channel every client is placed on (login reply, plaza/tutorial move-in, cluster move). 60 is "Free",
# a FighterConfigChannel column in every client; one shared lobby instead of split channels.
# BFF_PLAYER_CHANNEL=60
# Optional UDP patches are never mounted by default. Set the bound port before applying
# profiles/bundles/udp-relay.patch.yaml or udp-peers.patch.yaml to one audited build.
# Zero public port advertises the bound port; use the mapped port behind NAT.
# One switch controls UDP listeners, relay offers and peer setup in both patches.
# Set false and restart to diagnose over the existing TCP paths.
BFF_UDP_ENABLED=true
# BFF_UDP_PORT=7601
# BFF_UDP_PUBLIC_PORT=0
CN_324_GAME_PORT=7140
CN_324_PUBLIC_PORT=7140
CN_324_ADMIN_HOST=127.0.0.1
CN_324_ADMIN_PORT=8083
# Other profiles use their uppercase build prefix for GAME_PORT / PUBLIC_PORT.
KR_1256_GAME_PORT=7100
KR_1256_RELAY_PORT=7101
KR_1256_RELAY_PUBLIC_PORT=7101
# Legacy relays listen one above their game port (KR_812 7111, ID_400 7121, CN_324 7141, ...);
# PUBLIC_RELAY_PORT is the port written into the relay offer.
CN_324_RELAY_PORT=7141
CN_324_PUBLIC_RELAY_PORT=7141
# Hosts the launcher catalog of profile `all` advertises for the cn-774 and tw-454 instances.
# BFF_CN_774_HOST=127.0.0.1
# BFF_TW_454_HOST=127.0.0.1

# Shared cumulative experience thresholds for all configured client builds.
BFF_LEVEL_EXP_TABLE=data/level-experience.csv
# Final reward factors: 1 = normal, 100 = one hundred times normal.
BFF_REWARD_EXP_MULTIPLIER=100
BFF_REWARD_LUCCI_MULTIPLIER=100

# Optional native selector ports; inactive until center-selector.yaml is mounted.
# The ...1 ports are reserved for relay; PUBLIC_PORT may differ behind NAT.
KR_812_CENTER_PORT=7112
KR_812_CENTER_PUBLIC_PORT=7112
CN_324_CENTER_PORT=7142
CN_324_CENTER_PUBLIC_PORT=7142
CN_279_CENTER_PORT=7212
CN_279_CENTER_PUBLIC_PORT=7212

# Optional public launcher API; enable launcher.http and supply instances in a profile patch.
BFF_LAUNCHER_LISTEN=127.0.0.1:8090
# Single-use ticket lifetime from issuance, capped by the authorizing session.
BFF_LAUNCHER_TICKET_SECONDS=600
BFF_LAUNCHER_HOST_POLICY=auto
BFF_LAUNCHER_REGION=
# Oldest launcher allowed to sign in and start games; every earlier version is refused.
BFF_LAUNCHER_MINIMUM_VERSION=0.2.0
# true makes every build's lobby redeem launcher tickets at game login; requires launcher.http enabled.
BFF_LAUNCHER_TICKETS=false
# How a game login proves its account. ticket (default): only launcher tickets, needs launcher.http enabled.
# open: any account name the client sends logs in; use it only on a trusted LAN or for local testing.
BFF_LOGIN_AUTHENTICATION=ticket

# Optional explicit SQLite provider; see docs/configuration.md before enabling it.
# Keep this path outside release and log directories; use a persistent volume in containers.
# BFF_SQLITE_DATABASE_PATH=C:/ServerData/BF/save.sqlite

# Optional native messenger; the rows are disabled in core and enabled by a profile patch.
# Tenant name this server signs messenger tickets as; every game server sharing one messenger needs its own.
BFF_MESSENGER_TENANT=local
# P-256 private key (PEM or base64 PKCS#8) that signs messenger tickets; ephemeral generates one per start,
# which only an in-process messenger can trust and which invalidates outstanding tickets on restart.
BFF_MESSENGER_SIGNING_KEY=ephemeral
# Base URL handed to clients; {host} becomes the host the client used. Empty: http://{host}:8091.
BFF_MESSENGER_PUBLIC_URL=
BFF_MESSENGER_LISTEN=127.0.0.1:8091
# Standalone messenger profile only: the base64 SubjectPublicKeyInfo of the tenant's signing key.
# BFF_MESSENGER_TENANT_PUBLIC_KEY=

# Optional Fantasy Tale Nirinsou Link (launcher companion channel); disabled in core, enabled by a profile patch.
BFF_COMPANION_LISTEN=127.0.0.1:8092
# WebSocket URL handed to launchers, ending in /companion/v1; {host} becomes the host the launcher used.
# Empty: ws://{host}:<listen port>/companion/v1. Use a wss URL behind TLS termination for remote players.
BFF_COMPANION_PUBLIC_URL=

# Optional cluster discovery; standalone profiles do not mount these patches.
# This private listener is separate from the companion listener.
# BFF_CLUSTER_LISTEN=127.0.0.1:8093
# HTTP or HTTPS is selected explicitly by the operator; no automatic upgrade is performed.
# BFF_CLUSTER_DIRECTORY_URL=http://127.0.0.1:8093
# BFF_CLUSTER_NODE_ID=worker
# Supply a different random 32..256-character printable ASCII key for each node.
# BFF_CLUSTER_NODE_KEY=
# Optional account-ownership row: a secret authority connection string; no shipped profile mounts this row.
# BFF_CLUSTER_ACCOUNT_CONNECTION_STRING=
# Authoritative MySQL marker: SELECT REPLACE(domain_id, '-', '') FROM cluster_data_domain WHERE singleton_id = 1;
# Required by automatic selectors; do not generate a separate value for each worker.
# BFF_CLUSTER_DATA_DOMAIN_ID=
# Optional trusted worker ticket redemption, separate from heartbeat credentials.
# BFF_CLUSTER_TICKET_LISTEN=127.0.0.1:8094
# BFF_CLUSTER_TICKET_URL=https://authority.example
# BFF_CLUSTER_REDEMPTION_KEY=
# Optional issuer-side launch selection; these must match the configured directory authority and scope.
# BFF_CLUSTER_AUTHORITY_ID=primary
# BFF_CLUSTER_AUTHORITY_URL=https://authority.example
# BFF_CLUSTER_DATA_SCOPE=shared
# BFF_CLUSTER_AUTOMATIC_SELECTOR_ID=1

# TW454 fighter-info full native reply and target equipment cache; opt in for client acceptance.
BFF_TW_454_FIGHTER_INFO=false

# Optional pet bundles; all switches stay off until native-client acceptance.
# Include the pet bundle and its build-specific patches before enabling these rows.
BFF_PETS_ENABLED=true
BFF_PET_INITIAL_FULLNESS=0
BFF_PET_REWARDS_ENABLED=true
BFF_PET_COMBAT_ENABLED=true
BFF_PET_CANCELLATION_SEEDS=true
# Configure client clock, feeding source/cooldown and eligible reward/combat modes in a local patch.
# Manual feeding through DynamicConfig also requires an explicit mileage.display_maximum.

# Audited title exchange/selection on kr-812 and kr-1256; native acceptance is still required.
BFF_TITLES_ENABLED=true
# KR1256 custom options within native supported game modes; requires client acceptance.
BFF_CUSTOM_ROOM_RULES_ENABLED=true
# KR1256 ordinary permanent-item enhancement; the two plugin rows and dialect routes share this switch.
BFF_ITEM_ENHANCEMENT_ENABLED=true
# KR1256 weapon modification; the profile carries the native part table, weights and costs (edit them in a local patch).
BFF_ITEM_MODIFICATION_ENABLED=true
# KR1256 Favorite weapon points from successful enhancement and their native attribute 164 presentation; read from the client workbook.
BFF_FAVORITE_WEAPON_ENABLED=true
# KR1256 Favorite challenge titles 400312-400314: granted when 1, 2 or 3 weapons reach Master; needs BFF_TITLES_ENABLED and BFF_FAVORITE_WEAPON_ENABLED.
BFF_FAVORITE_TITLES_ENABLED=true
# KR812 native synthesis; the profile carries a card and duration policy (decomposition needs reward pools in a local patch).
BFF_SCIENCE_LAB_ENABLED=true
# Server recipe policy for enhancement; the profile defaults are shown and any value can be overridden here.
# BFF_ENHANCEMENT_SUCCESS_BASIS_POINTS=5000
# BFF_ENHANCEMENT_ADDITIVE_SUCCESS_BASIS_POINTS=10000
# BFF_ENHANCEMENT_CARD_QUANTITY=1
# BFF_ENHANCEMENT_KIT_QUANTITY=2
# BFF_ENHANCEMENT_ADDITIVE_QUANTITY=1
