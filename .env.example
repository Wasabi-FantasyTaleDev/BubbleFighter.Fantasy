# Copy to .env and fill in real values. .env is git-ignored; never commit credentials.

# MySQL server hostname or IP used by the persistence.mysql plugin row.
# Docker Compose overrides this to the mysql service name inside the bff container.
BFF_MYSQL_HOST=127.0.0.1
# MySQL port.
BFF_MYSQL_PORT=3306
# MySQL user. Compose creates this account (must not be the server administrator name).
# Native installs that use a different account should override this.
BFF_MYSQL_USER=bff
# MySQL password. Profile interpolation requires a nonempty value even when a final
# patch disables MySQL. Use a disposable value for isolated-memory local checks.
BFF_MYSQL_PASSWORD=
# MySQL database name (any existing database; bf_game_db is only the default).
BFF_MYSQL_DATABASE=bf_game_db

# First-run setup token, at least 32 random characters. Required by deploy/docker/compose.yaml, whose
# setup page is reached from outside the container; a loopback-only setup does not need it.
BFF_SETUP_TOKEN=

# Console log level: Trace, Debug, Information, Warning, Error, Critical, None.
BFF_LOG_LEVEL=Information
# Optional packet diagnostics; disabled during normal operation. Logs may contain user data.
BFF_PACKET_CAPTURE=false

# Client data: <dir>/<build>/data holds the client archives the server reads at their original
# client paths (e.g. Packs/ServerShared_00000.pkn, Config/Config.bfz); <dir>/<build>/dataraw holds
# loose unpacked files by client path, read first. Supply the matching local client data.
# BFF_CLIENT_DATA=client-data

# Listener and advertised addresses; use distinct values behind NAT.
BFF_BIND_HOST=0.0.0.0
BFF_PUBLIC_HOST=127.0.0.1
CN_324_GAME_PORT=7140
CN_324_PUBLIC_PORT=7140
CN_324_ADMIN_HOST=127.0.0.1
CN_324_ADMIN_PORT=8083
# Other profiles use their uppercase build prefix for GAME_PORT / PUBLIC_PORT.
KR_1256_GAME_PORT=7100
KR_1256_RELAY_PORT=7101
KR_1256_RELAY_PUBLIC_PORT=7101
# Hosts the launcher catalog of profile `all` advertises for the cn-774 and tw-454 instances.
# BFF_CN_774_HOST=127.0.0.1
# BFF_TW_454_HOST=127.0.0.1

# Shared cumulative experience thresholds for all configured client builds.
BFF_LEVEL_EXP_TABLE=data/level-experience.csv
# Final reward factors: 1 = normal, 100 = one hundred times normal.
BFF_REWARD_EXP_MULTIPLIER=100
BFF_REWARD_LUCCI_MULTIPLIER=100

# Optional native selector ports; inactive until center-selector.yaml is mounted.
# The ...1 ports are reserved for relay; PUBLIC_PORT may differ behind NAT.
KR_812_CENTER_PORT=7112
KR_812_CENTER_PUBLIC_PORT=7112
CN_324_CENTER_PORT=7142
CN_324_CENTER_PUBLIC_PORT=7142
CN_279_CENTER_PORT=7212
CN_279_CENTER_PUBLIC_PORT=7212

# Optional public launcher API; enable launcher.http and supply instances in a profile patch.
BFF_LAUNCHER_LISTEN=127.0.0.1:8090
# Single-use ticket lifetime from issuance, capped by the authorizing session.
BFF_LAUNCHER_TICKET_SECONDS=600
BFF_LAUNCHER_HOST_POLICY=auto
BFF_LAUNCHER_REGION=
# true makes every build's lobby redeem launcher tickets at game login; requires launcher.http enabled.
BFF_LAUNCHER_TICKETS=false
# How a game login proves its account. ticket (default): only launcher tickets, needs launcher.http enabled.
# open: any account name the client sends logs in; use it only on a trusted LAN or for local testing.
BFF_LOGIN_AUTHENTICATION=ticket

# Optional explicit SQLite provider; see docs/configuration.md before enabling it.
# Keep this path outside release and log directories; use a persistent volume in containers.
# BFF_SQLITE_DATABASE_PATH=C:/ServerData/BF/save.sqlite

# Optional native messenger; the rows are disabled in core and enabled by a profile patch.
# Tenant name this server signs messenger tickets as; every game server sharing one messenger needs its own.
BFF_MESSENGER_TENANT=local
# P-256 private key (PEM or base64 PKCS#8) that signs messenger tickets; ephemeral generates one per start,
# which only an in-process messenger can trust and which invalidates outstanding tickets on restart.
BFF_MESSENGER_SIGNING_KEY=ephemeral
# Base URL handed to clients; {host} becomes the host the client used. Empty: http://{host}:8091.
BFF_MESSENGER_PUBLIC_URL=
BFF_MESSENGER_LISTEN=127.0.0.1:8091
# Standalone messenger profile only: the base64 SubjectPublicKeyInfo of the tenant's signing key.
# BFF_MESSENGER_TENANT_PUBLIC_KEY=

# Optional Fantasy Tale Nirinsou Link (launcher companion channel); disabled in core, enabled by a profile patch.
BFF_COMPANION_LISTEN=127.0.0.1:8092
# WebSocket URL handed to launchers, ending in /companion/v1; {host} becomes the host the launcher used.
# Empty: ws://{host}:<listen port>/companion/v1. Use a wss URL behind TLS termination for remote players.
BFF_COMPANION_PUBLIC_URL=
